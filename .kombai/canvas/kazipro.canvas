      "html": "\n<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap');\n  * { box-sizing: border-box; margin: 0; padding: 0; }\n  body { font-family: 'DM Sans', sans-serif; background: #f7f5f0; color: #1a2133; }\n  h1,h2,h3,h4,h5,h6 { font-family: 'Plus Jakarta Sans', sans-serif; }\n</style>\n\n\n<nav style=\"background:#f7f5f0; border-bottom:1px solid #e5e1d8;\" data-kid=\"1\">\n  <div style=\"max-width:1280px; margin:0 auto; padding:0 40px; height:68px; display:flex; align-items:center; justify-content:space-between;\" data-kid=\"2\">\n    <div style=\"display:flex; align-items:center; gap:8px;\" data-kid=\"3\">\n      <div style=\"width:36px; height:36px; background:linear-gradient(135deg,#1a5c35,#2a8a52); border-radius:10px; display:flex; align-items:center; justify-content:center;\" data-kid=\"4\">\n        <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"white\" stroke-width=\"2.5\" data-kid=\"5\"><path d=\"M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5\" data-kid=\"6\"></path></svg>\n      </div>\n      <span style=\"font-family:'Plus Jakarta Sans',sans-serif; font-size:20px; font-weight:800; color:#1a2133;\" data-kid=\"7\">KaziPro</span>\n    </div>\n    <div style=\"display:flex; align-items:center; gap:32px;\" data-kid=\"8\">\n      <a href=\"#\" style=\"font-size:14px; font-weight:600; color:#1a5c35; text-decoration:none;\" data-kid=\"9\">Services</a>\n      <a href=\"#\" style=\"font-size:14px; font-weight:500; color:#4a5568; text-decoration:none;\" data-kid=\"10\">Comment ça marche</a>\n      <a href=\"#\" style=\"font-size:14px; font-weight:500; color:#4a5568; text-decoration:none;\" data-kid=\"11\">À propos</a>\n    </div>\n    <div style=\"display:flex; align-items:center; gap:12px;\" data-kid=\"12\">\n      <button style=\"font-size:14px; font-weight:600; color:#1a5c35; background:none; border:1px solid #1a5c35; border-radius:10px; padding:9px 20px; cursor:pointer;\" data-kid=\"13\">Connexion</button>\n      <button style=\"font-size:14px; font-weight:600; color:white; background:#e07a1f; border:none; border-radius:10px; padding:9px 20px; cursor:pointer;\" data-kid=\"14\">Inscription gratuite</button>\n    </div>\n  </div>\n</nav>\n\n\n<section style=\"background:linear-gradient(145deg,#13182a 0%,#1a5c35 55%,#1d6b41 100%); padding:40px 40px 56px; position:relative; overflow:hidden;\" data-kid=\"15\">\n  <div style=\"pointer-events:none; position:absolute; inset:0; opacity:0.04; background-image:linear-gradient(to right,white 1px,transparent 1px),linear-gradient(to bottom,white 1px,transparent 1px); background-size:56px 56px;\" data-kid=\"16\"></div>\n  <div style=\"pointer-events:none; position:absolute; top:-40px; right:8%; width:360px; height:360px; border-radius:50%; background:rgba(224,122,31,0.2); filter:blur(60px);\" data-kid=\"17\"></div>\n  <div style=\"max-width:1280px; margin:0 auto; position:relative; z-index:2;\" data-kid=\"18\">\n    \n    <div style=\"display:flex; align-items:center; gap:8px; margin-bottom:24px; font-size:13px; color:rgba(255,255,255,0.55);\" data-kid=\"19\">\n      <a href=\"#\" style=\"color:rgba(255,255,255,0.55); text-decoration:none;\" data-kid=\"20\">Accueil</a>\n      <svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" data-kid=\"21\"><path d=\"M9 18l6-6-6-6\" data-kid=\"22\"></path></svg>\n      <a href=\"#\" style=\"color:rgba(255,255,255,0.55); text-decoration:none;\" data-kid=\"23\">Services</a>\n      <svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" data-kid=\"24\"><path d=\"M9 18l6-6-6-6\" data-kid=\"25\"></path></svg>\n      <span style=\"color:rgba(255,255,255,0.85);\" data-kid=\"26\">Électricité</span>\n    </div>\n    <div style=\"display:flex; align-items:center; gap:20px;\" data-kid=\"27\">\n      <div style=\"width:72px; height:72px; border-radius:18px; background:linear-gradient(135deg,#facc15,#f97316); display:flex; align-items:center; justify-content:center; flex-shrink:0; box-shadow:0 8px 24px rgba(249,115,22,0.4);\" data-kid=\"28\">\n        <svg width=\"34\" height=\"34\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"white\" stroke-width=\"2\" stroke-linecap=\"round\" data-kid=\"29\"><polygon points=\"13,2 3,14 12,14 11,22 21,10 12,10\" data-kid=\"30\"></polygon></svg>\n      </div>\n      <div data-kid=\"31\">\n        <p style=\"font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:0.18em; color:rgba(255,255,255,0.55); margin-bottom:6px;\" data-kid=\"32\">Métier vérifié</p>\n        <h1 style=\"font-family:'Plus Jakarta Sans',sans-serif; font-size:44px; font-weight:800; color:white; letter-spacing:-0.02em; line-height:1.1; margin-bottom:8px;\" data-kid=\"33\">Électricité</h1>\n        <p style=\"font-size:15px; color:rgba(255,255,255,0.75);\" data-kid=\"34\">Installation, réparation et mise aux normes des installations électriques.</p>\n      </div>\n      <div style=\"margin-left:auto; display:flex; gap:24px;\" data-kid=\"35\">\n        <div style=\"text-align:center;\" data-kid=\"36\">\n          <div style=\"font-family:'Plus Jakarta Sans',sans-serif; font-size:28px; font-weight:800; color:white;\" data-kid=\"37\">24</div>\n          <div style=\"font-size:12px; color:rgba(255,255,255,0.6);\" data-kid=\"38\">Prestataires</div>\n        </div>\n        <div style=\"text-align:center;\" data-kid=\"39\">\n          <div style=\"font-family:'Plus Jakarta Sans',sans-serif; font-size:28px; font-weight:800; color:white;\" data-kid=\"40\">4.8</div>\n          <div style=\"font-size:12px; color:rgba(255,255,255,0.6);\" data-kid=\"41\">Note moy.</div>\n        </div>\n        <div style=\"text-align:center;\" data-kid=\"42\">\n          <div style=\"font-family:'Plus Jakarta Sans',sans-serif; font-size:28px; font-weight:800; c