 17,14.14 18.18,21.02 12,17.77 5.82,21.02 7,14.14 2,9.27 8.91,8.26\" data-kid=\"279\"></polygon></svg>\n            <svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"#e07a1f\" stroke=\"none\" data-kid=\"280\"><polygon points=\"12,2 15.09,8.26 22,9.27 17,14.14 18.18,21.02 12,17.77 5.82,21.02 7,14.14 2,9.27 8.91,8.26\" data-kid=\"281\"></polygon></svg>\n            <svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"#e07a1f\" stroke=\"none\" data-kid=\"282\"><polygon points=\"12,2 15.09,8.26 22,9.27 17,14.14 18.18,21.02 12,17.77 5.82,21.02 7,14.14 2,9.27 8.91,8.26\" data-kid=\"283\"></polygon></svg>\n            <svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"#e07a1f\" stroke=\"none\" data-kid=\"284\"><polygon points=\"12,2 15.09,8.26 22,9.27 17,14.14 18.18,21.02 12,17.77 5.82,21.02 7,14.14 2,9.27 8.91,8.26\" data-kid=\"285\"></polygon></svg>\n            <svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"#e07a1f\" stroke=\"none\" data-kid=\"286\"><polygon points=\"12,2 15.09,8.26 22,9.27 17,14.14 18.18,21.02 12,17.77 5.82,21.02 7,14.14 2,9.27 8.91,8.26\" data-kid=\"287\"></polygon></svg>\n          </div>\n          <p style=\"font-size:14px; color:#4a5568; line-height:1.65; margin-bottom:16px; font-style:italic;\" data-kid=\"288\">\"Grâce à KaziPro, j'ai triplé mes missions en 3 mois. Le système de contrats me protège vraiment.\"</p>\n          <div style=\"display:flex; align-items:center; gap:10px;\" data-kid=\"289\">\n            <img src=\"https://i.pravatar.cc/36?u=paul-prestataire\" decoding=\"async\" loading=\"lazy\" style=\"width:36px; height:36px; border-radius:50%; object-fit:cover;\" alt=\"Paul M.\" data-kid=\"290\">\n            <div data-kid=\"291\">\n              <p style=\"font-size:13px; font-weight:700; color:#1a2133;\" data-kid=\"292\">Paul M.</p>\n              <p style=\"font-size:12px; color:#9ca3af;\" data-kid=\"293\">Électricien, Lubumbashi</p>\n            </div>\n          </div>\n        </div>\n        <div style=\"background:#1a5c35; border-radius:16px; padding:24px; box-shadow:0 8px 24px rgba(26,92,53,0.3); grid-column:span 2;\" data-kid=\"294\">\n          <p style=\"font-family:'Plus Jakarta Sans',sans-serif; font-size:15px; font-weight:700; color:white; margin-bottom:8px;\" data-kid=\"295\">Note globale</p>\n          <div style=\"display:flex; align-items:center; gap:12px;\" data-kid=\"296\">\n            <span style=\"font-family:'Plus Jakarta Sans',sans-serif; font-size:48px; font-weight:800; color:white;\" data-kid=\"297\">4.8</span>\n            <div data-kid=\"298\">\n              <div style=\"display:flex; gap:3px; margin-bottom:4px;\" data-kid=\"299\">\n                <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"#e07a1f\" stroke=\"none\" data-kid=\"300\"><polygon points=\"12,2 15.09,8.26 22,9.27 17,14.14 18.18,21.02 12,17.77 5.82,21.02 7,14.14 2,9.27 8.91,8.26\" data-kid=\"301\"></polygon></svg>\n                <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"#e07a1f\" stroke=\"none\" data-kid=\"302\"><polygon points=\"12,2 15.09,8.26 22,9.27 17,14.14 18.18,21.02 12,17.77 5.82,21.02 7,14.14 2,9.27 8.91,8.26\" data-kid=\"303\"></polygon></svg>\n                <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"#e07a1f\" stroke=\"none\" data-kid=\"304\"><polygon points=\"12,2 15.09,8.26 22,9.27 17,14.14 18.18,21.02 12,17.77 5.82,21.02 7,14.14 2,9.27 8.91,8.26\" data-kid=\"305\"></polygon></svg>\n                <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"#e07a1f\" stroke=\"none\" data-kid=\"306\"><polygon points=\"12,2 15.09,8.26 22,9.27 17,14.14 18.18,21.02 12,17.77 5.82,21.02 7,14.14 2,9.27 8.91,8.26\" data-kid=\"307\"></polygon></svg>\n                <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"rgba(224,122,31,0.5)\" stroke=\"#e07a1f\" stroke-width=\"1\" data-kid=\"308\"><polygon points=\"12,2 15.09,8.26 22,9.27 17,14.14 18.18,21.02 12,17.77 5.82,21.02 7,14.14 2,9.27 8.91,8.26\" data-kid=\"309\"></polygon></svg>\n              </div>\n              <p style=\"font-size:12px; color:rgba(255,255,255,0.7);\" data-kid=\"310\">Basé sur 342 avis vérifiés</p>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </div>\n</section>\n\n\n<section style=\"background:linear-gradient(135deg,#13182a 0%,#1a5c35 60%,#1d6b41 100%); padding:80px 40px; position:relative; overflow:hidden;\" data-kid=\"311\">\n  <div style=\"pointer-events:none; position:absolute; inset:0; opacity:0.06;\" data-kid=\"312\">\n    <div style=\"position:absolute; top:0; right:0; width:100%; height:100%; background:radial-gradient(circle at 70% 30%,rgba(255,255,255,0.2),transparent 50%);\" data-kid=\"313\"></div>\n  </div>\n  <div style=\"max-width:1280px; margin:0 auto; position:relative; z-index:2;\" data-kid=\"314\">\n    <div style=\"text-align:center; margin-bottom:56px;\" data-kid=\"315\">\n      <h2 style=\"font-family:'Plus Jakarta Sans',sans-serif; font-size:48px; font-weight:800; color:white; margin-bottom:18px; letter-spacing:-0.02em;\" data-kid=\"316\">Prêt à commencer ?</h2>\n      <p style=\"font-size:18px; color:rgba(255,255,255,0.82); max-width:560px; margin:0 auto 28px; line-height:1.65;\" data-kid=\"317\">Inscrivez-vous gratuitement ou connectez-vous pour reprendre une demande, un devis ou une mission en cours.</p>\n      <button style=\"display:inline-flex; align-items:center; gap:8px; padding:11px 22px; border-radius:10px; border:1px solid rgba(255,255,255,0.35); background:transparent; color:white; font-size:14px; font-weight:600; font-family:'DM Sans',sans-serif; cursor:pointer;\" data-kid=\"318\">\n        <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" data-kid=\"319\"><path d=\"M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4\" data-kid=\"320\"></path><polyline points=\"10,17 15,12 10,7\" data-kid=\"321\"></polyline><line x1=\"15\" y1=\"12\" x2=\"3\" y2=\"12\" data-kid=\"322\"></line></svg>\n        Déjà membre ?\n      </button>\n    </div>\n    <div style=\"display:grid; grid-template-columns:1fr 1fr; gap:24px; max-width:900px; margin:0 auto;\" data-kid=\"323\">\n      \n      <div style=\"background:rgba(255,255,255,0.1); backdrop-filter:blur(16px); border-radius:24px; padding:40px; border:1px solid rgba(255,255,255,0.2);\" data-kid=\"324\">\n        <div style=\"display:inline-flex; align-items:center; padding:6px 14px; border-radius:100px; background:rgba(224,122,31,0.25); color:#e07a1f; font-size:12px; font-weight:700; margin-bottom:20px; text-transform:uppercase; letter-spacing:0.06em;\" data-kid=\"325\">Pour les clients</div>\n        <h3 style=\"font-family:'Plus Jakarta Sans',sans-serif; font-size:26px; font-weight:800; color:white; margin-bottom:12px; line-height:1.2;\" data-kid=\"326\">Trouvez votre professionnel</h3>\n        <p style=\"font-size:15px; color:rgba(255,255,255,0.78); margin-bottom:28px; line-height:1.65;\" data-kid=\"327\">Publiez votre demande gratuitement et recevez des devis de prestataires qualifiés en moins de 24h.</p>\n        <button style=\"width:100%; display:flex; align-items:center; justify-content:center; gap:8px; padding:15px 24px; border-radius:12px; background:white; color:#1a5c35; font-size:16px; font-weight:700; font-family:'DM Sans',sans-serif; border:none; cursor:pointer;\" data-kid=\"328\">\n          Publier une demande\n          <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" data-kid=\"329\"><path d=\"M5 12h14M12 5l7 7-7 7\" data-kid=\"330\"></path></svg>\n        </button>\n      </div>\n      \n      <div style=\"background:rgba(224,122,31,0.18); backdrop-filter:blur(16px); border-radius:24px; padding:40px; border:1px solid rgba(224,122,31,0.3);\" data-kid=\"331\">\n        <div style=\"display:inline-flex; align-items:center; padding:6px 14px; border-radius:100px; background:rgba(255,255,255,0.2); color:white; font-size:12px; font-weight:700; margin-bottom:20px; text-transform:uppercase; letter-spacing:0.06em;\" data-kid=\"332\">Pour les professionnels</div>\n        <h3 style=\"font-family:'Plus Jakarta Sans',sans-serif; font-size:26px; font-weight:800; color:white; margin-bottom:12px; line-height:1.2;\" data-kid=\"333\">Développez votre activité</h3>\n        <p style=\"font-size:15px; color:rgba(255,255,255,0.78); margin-bottom:28px; line-height:1.65;\" data-kid=\"334\">Accédez à de nouvelles opportunités, gérez vos missions et recevez vos paiements en toute sécurité.</p>\n        <button style=\"width:100%; display:flex; align-items:center; justify-content:center; gap:8px; padding:15px 24px; border-radius:12px; background:white; color:#1a5c35; font-size:16px; font-weight:700; font-family:'DM Sans',sans-serif; border:none; cursor:pointer;\" data-kid=\"335\">\n          <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" data-kid=\"336\"><path d=\"M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z\" data-kid=\"337\"></path><polyline points=\"9,22 9,12 15,12 15,22\" data-kid=\"338\"></polyline></svg>\n          Devenir prestataire\n          <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" data-kid=\"339\"><path d=\"M5 12h14M12 5l7 7-7 7\" data-kid=\"340\"></path></svg>\n        </button>\n      </div>\n    </div>\n  </div>\n</section>\n\n\n<footer style=\"background:#13182a; padding:60px 40px 32px;\" data-kid=\"341\">\n  <div style=\"max-width:1280px; margin:0 auto;\" data-kid=\"342\">\n    <div style=\"display:grid; grid-template-columns:2.5fr 1fr 1fr 1fr; gap:48px; margin-bottom:48px;\" data-kid=\"343\">\n      <div data-kid=\"344\">\n        <div style=\"display:flex; align-items:center; gap:8px; margin-bottom:16px;\" data-kid=\"345\">\n          <div style=\"width:34px; height:34px; background:linear-gradient(135deg,#1a5c35,#2a8a52); border-radius:9px; display:flex; align-items:center; justify-content:center;\" data-kid=\"346\">\n            <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"white\" stroke-width=\"2.5\" data-kid=\"347\"><path d=\"M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5\" data-kid=\"348\"></path></svg>\n          </div>\n          <span style=\"font-family:'Plus Jakarta Sans',sans-serif; font-size:18px; font-weight:800; color:white;\" data-kid=\"349\">KaziPro</span>\n        </div>\n        <p style=\"font-size:14px; color:rgba(255,255,255,0.55); line-height:1.7; max-width:280px;\" data-kid=\"350\">La plateforme de mise en relation entre clients et professionnels vérifiés en République Démocratique du Congo.</p>\n      </div>\n      <div data-kid=\"351\">\n        <p style=\"font-size:12px; font-weight:700; text-transform:uppercase; letter-spacing:0.12em; color:rgba(255,255,255,0.4); margin-bottom:16px;\" data-kid=\"352\">Plateforme</p>\n        <div style=\"display:flex; flex-direction:column; gap:10px;\" data-kid=\"353\">\n          <a href=\"#\" style=\"font-size:14px; color:rgba(255,255,255,0.65); text-decoration:none;\" data-kid=\"354\">Services</a>\n          <a href=\"#\" style=\"font-size:14px; color:rgba(255,255,255,0.65); text-decoration:none;\" data-kid=\"355\">Comment ça marche</a>\n          <a href=\"#\" style=\"font-size:14px; color:rgba(255,255,255,0.65); text-decoration:none;\" data-kid=\"356\">Tarifs</a>\n          <a href=\"#\" style=\"font-size:14px; color:rgba(255,255,255,0.65); text-decoration:none;\" data-kid=\"357\">À propos</a>\n        </div>\n      </div>\n      <div data-kid=\"358\">\n        <p style=\"font-size:12px; font-weight:700; text-transform:uppercase; letter-spacing:0.12em; color:rgba(255,255,255,0.4); margin-bottom:16px;\" data-kid=\"359\">Compte</p>\n        <div style=\"display:flex; flex-direction:column; gap:10px;\" data-kid=\"360\">\n          <a href=\"#\" style=\"font-size:14px; color:rgba(255,255,255,0.