      "html": "\n<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap');\n  * { box-sizing: border-box; margin: 0; padding: 0; }\n  body { font-family: 'DM Sans', sans-serif; background: #f7f5f0; color: #1a2133; }\n  h1,h2,h3,h4,h5,h6 { font-family: 'Plus Jakarta Sans', sans-serif; }\n</style>\n\n<div style=\"display:flex; min-height:100%; background:#f7f5f0;\" data-kid=\"1\">\n  \n  <aside style=\"width:260px; background:#13182a; flex-shrink:0; display:flex; flex-direction:column; min-height:860px;\" data-kid=\"2\">\n    \n    <div style=\"padding:24px 20px 20px; border-bottom:1px solid rgba(255,255,255,0.08);\" data-kid=\"3\">\n      <div style=\"display:flex; align-items:center; gap:10px;\" data-kid=\"4\">\n        <div style=\"width:36px; height:36px; background:linear-gradient(135deg,#1a5c35,#2a8a52); border-radius:10px; display:flex; align-items:center; justify-content:center; flex-shrink:0;\" data-kid=\"5\">\n          <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"white\" stroke-width=\"2.5\" data-kid=\"6\"><path d=\"M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5\" data-kid=\"7\"></path></svg>\n        </div>\n        <span style=\"font-family:'Plus Jakarta Sans',sans-serif; font-size:18px; font-weight:800; color:white; letter-spacing:-0.01em;\" data-kid=\"8\">KaziPro</span>\n      </div>\n    </div>\n    \n    <div style=\"padding:20px; border-bottom:1px solid rgba(255,255,255,0.08);\" data-kid=\"9\">\n      <div style=\"display:flex; align-items:center; gap:12px;\" data-kid=\"10\">\n        <div style=\"position:relative; flex-shrink:0;\" data-kid=\"11\">\n          <img src=\"https://i.pravatar.cc/44?u=jean-baptiste-provider\" decoding=\"async\" loading=\"lazy\" style=\"width:44px; height:44px; border-radius:12px; object-fit:cover; border:2px solid rgba(255,255,255,0.15);\" alt=\"Jean-Baptiste\" data-kid=\"12\">\n          <span style=\"position:absolute; bottom:2px; right:2px; width:10px; height:10px; background:#22c55e; border-radius:50%; border:2px solid #13182a;\" data-kid=\"13\"></span>\n        </div>\n        <div style=\"min-width:0;\" data-kid=\"14\">\n          <p style=\"font-family:'Plus Jakarta Sans',sans-serif; font-size:14px; font-weight:700; color:white; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;\" data-kid=\"15\">Jean-Baptiste M.</p>\n          <p style=\"font-size:12px; color:rgba(255,255,255,0.55); margin-bottom:5px;\" data-kid=\"16\">Électricien · Kinshasa</p>\n          <div style=\"display:inline-flex; align-items:center; gap:4px; background:rgba(34,197,94,0.15); border:1px solid rgba(34,197,94,0.3); border-radius:100px; padding:2px 8px;\" data-kid=\"17\">\n            <span style=\"width:6px; height:6px; background:#22c55e; border-radius:50%;\" data-kid=\"18\"></span>\n            <span style=\"font-size:10px; color:#86efac; font-weight:600;\" data-kid=\"19\">Disponible</span>\n          </div>\n        </div>\n      </div>\n    </div>\n    \n    <nav style=\"padding:12px 12px; flex:1; display:flex; flex-direction:column; gap:2px;\" data-kid=\"20\">\n      \n      <div style=\"display:flex; align-items:center; gap:12px; padding:11px 14px; border-radius:10px; background:rgba(224,122,31,0.18); border:1px solid rgba(224,122,31,0.3); cursor:pointer;\" data-kid=\"21\">\n        <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#e07a1f\" stroke-width=\"2\" data-kid=\"22\"><rect x=\"3\" y=\"3\" width=\"7\" height=\"7\" data-kid=\"23\"></rect><rect x=\"14\" y=\"3\" width=\"7\" height=\"7\" data-kid=\"24\"></rect><rect x=\"3\" y=\"14\" width=\"7\" height=\"7\" data-kid=\"25\"></rect><rect x=\"14\" y=\"14\" width=\"7\" height=\"7\" data-kid=\"26\"></rect></svg>\n        <span style=\"font-size:14px; font-weight:600; color:#e07a1f;\" data-kid=\"27\">Tableau de bord</span>\n      </div>\n      <div style=\