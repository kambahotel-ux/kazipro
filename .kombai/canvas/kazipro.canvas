4\"></polygon></svg>\n                      <svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"#e07a1f\" stroke=\"none\" data-kid=\"215\"><polygon points=\"12,2 15.09,8.26 22,9.27 17,14.14 18.18,21.02 12,17.77 5.82,21.02 7,14.14 2,9.27 8.91,8.26\" data-kid=\"216\"></polygon></svg>\n                      <svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"#e07a1f\" stroke=\"none\" data-kid=\"217\"><polygon points=\"12,2 15.09,8.26 22,9.27 17,14.14 18.18,21.02 12,17.77 5.82,21.02 7,14.14 2,9.27 8.91,8.26\" data-kid=\"218\"></polygon></svg>\n                      <svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"rgba(224,122,31,0.4)\" stroke=\"#e07a1f\" stroke-width=\"1\" data-kid=\"219\"><polygon points=\"12,2 15.09,8.26 22,9.27 17,14.14 18.18,21.02 12,17.77 5.82,21.02 7,14.14 2,9.27 8.91,8.26\" data-kid=\"220\"></polygon></svg>\n                    </div>\n                  </div>\n                  <p style=\"font-size:12px; color:#6b7280; line-height:1.5; font-style:italic;\" data-kid=\"221\">\"Bon travail, quelques petits ajustements à faire.\"</p>\n                </div>\n              </div>\n            </div>\n          </div>\n\n          \n          <div style=\"background:white; border-radius:16px; border:1px solid #e5e1d8; padding:22px; box-shadow:0 2px 8px rgba(0,0,0,0.04);\" data-kid=\"222\">\n            <h2 style=\"font-family:'Plus Jakarta Sans',sans-serif; font-size:15px; font-weight:700; color:#1a2133; margin-bottom:16px;\" data-kid=\"223\">Actions rapides</h2>\n            <div style=\"display:flex; flex-direction:column; gap:10px;\" data-kid=\"224\">\n              <button style=\"display:flex; align-items:center; gap:12px; padding:13px 16px; border-radius:12px; background:#f7f5f0; border:1px solid #e5e1d8; cursor:pointer; text-align:left;\" data-kid=\"225\">\n                <div style=\"width:36px; height:36px; border-radius:10px; background:#f0f7f3; display:flex; align-items:center; justify-content:center; flex-shrink:0;\" data-kid=\"226\">\n                  <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#1a5c35\" stroke-width=\"2\" data-kid=\"227\"><line x1=\"12\" y1=\"5\" x2=\"12\" y2=\"19\" data-kid=\"228\"></line><line x1=\"5\" y1=\"12\" x2=\"19\" y2=\"12\" data-kid=\"229\"></line></svg>\n                </div>\n                <span style=\"font-size:14px; font-weight:600; color:#1a2133; flex:1;\" data-kid=\"230\">Créer un devis</span>\n                <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#9ca3af\" stroke-width=\"2\" data-kid=\"231\"><path d=\"M9 18l6-6-6-6\" data-kid=\"232\"></path></svg>\n              </button>\n              <button style=\"display:flex; align-items:center; gap:12px; padding:13px 16px; border-radius:12px; background:#f7f5f0; border:1px solid #e5e1d8; cursor:pointer; text-align:left;\" data-kid=\"233\">\n                <div style=\"width:36px; height:36px; border-radius:10px; background:#fef3e7; display:flex; align-items:center; justify-content:center; flex-shrink:0;\" data-kid=\"234\">\n                  <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#e07a1f\" stroke-width=\"2\" data-kid=\"235\"><path d=\"M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z\" data-kid=\"236\"></path></svg>\n                </div>\n                <span style=\"font-size:14px; font-weight:600; color:#1a2133; flex:1;\" data-kid=\"237\">Signer un contrat</span>\n                <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#9ca3af\" stroke-width=\"2\" data-kid=\"238\"><path d=\"M9 18l6-6-6-6\" data-kid=\"239\"></path></svg>\n              </button>\n              <button style=\"display:flex; align-items:center; gap:12px; padding:13px 16px; border-radius:12px; background:#f7f5f0; border:1px solid #e5e1d8; cursor:pointer; text-align:left;\" data-kid=\"240\">\n                <div style=\"width:36px; height:36px; border-radius:10px; background:#eff6f