      "html": "\n<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap');\n  * { box-sizing: border-box; margin: 0; padding: 0; }\n  body { font-family: 'DM Sans', sans-serif; background: #f7f5f0; color: #1a2133; }\n  h1,h2,h3,h4,h5,h6 { font-family: 'Plus Jakarta Sans', sans-serif; }\n</style>\n\n\n<nav style=\"background:#f7f5f0; border-bottom:1px solid #e5e1d8;\" data-kid=\"1\">\n  <div style=\"max-width:1280px; margin:0 auto; padding:0 40px; height:68px; display:flex; align-items:center; justify-content:space-between;\" data-kid=\"2\">\n    <div style=\"display:flex; align-items:center; gap:8px;\" data-kid=\"3\">\n      <div style=\"width:36px; height:36px; background:linear-gradient(135deg,#1a5c35,#2a8a52); border-radius:10px; display:flex; align-items:center; justify-content:center;\" data-kid=\"4\">\n        <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"white\" stroke-width=\"2.5\" data-kid=\"5\"><path d=\"M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5\" data-kid=\"6\"></path></svg>\n      </div>\n      <span style=\"font-family:'Plus Jakarta Sans',sans-serif; font-size:20px; font-weight:800; color:#1a2133; letter-spacing:-0.02em;\" data-kid=\"7\">KaziPro</span>\n    </div>\n    <div style=\"display:flex; align-items:center; gap:32px;\" data-kid=\"8\">\n      <a href=\"#\" style=\"font-size:14px; font-weight:600; color:#1a5c35; text-decoration:none; border-bottom:2px solid #1a5c35; padding-bottom:2px;\" data-kid=\"9\">Services</a>\n      <a href=\"#\" style=\"font-size:14px; font-weight:500; color:#4a5568; text-decoration:none;\" data-kid=\"10\">Comment ça marche</a>\n      <a href=\"#\" style=\"font-size:14px; font-weight:500; color:#4a5568; text-decoration:none;\" data-kid=\"11\">À propos</a>\n    </div>\n    <div style=\"display:flex; align-items:center; gap:12px;\" data-kid=\"12\">\n      <button style=\"font-size:14px; font-weight:600; color:#1a5c35; background:none; border:1px solid #1a5c35; border-radius:10px; padding:9px 20px; cursor:pointer;\" data-kid=\"13\">Connexion</button>\n      <button style=\"font-size:14px; font-weight:600; color:white; background:#e07a1f; border:none; border-radius:10px; padding:9px 20px; cursor:pointer;\" data-kid=\"14\">Inscription gratuite</button>\n    </div>\n  </div>\n</nav>\n\n\n<section style=\"background:linear-gradient(145deg,#13182a 0%,#1a5c35 55%,#1d6b41 100%); padding:56px 40px 64px; position:relative; overflow:hidden;\" data-kid=\"15\">\n  <div style=\"pointer-events:none; position:absolute; inset:0;\" data-kid=\"16\">\n    <div style=\"position:absolute; inset:0; opacity:0.04; background-image:linear-gradient(to right,white 1px,transparent 1px),linear-gradient(to bottom,white 1px,transparent 1px); background-size:56px 56px;\" data-kid=\"17\"></div>\n    <div style=\"position:absolute; top:-40px; right:10%; width:400px; height:400px; border-radius:50%; background:rgba(224,122,31,0.2); filter:blur(60px);\" data-kid=\"18\"></div>\n  </div>\n  <div style=\"max-width:1280px; margin:0 auto; position:relative; z-index:2; text-align:center;\" data-kid=\"19\">\n    <p style=\"font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:0.18em; color:rgba(255,255,255,0.6); margin-bottom:12px; display:inline-flex; align-items:center; gap:8px;\" data-kid=\"20\">\n      <svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#e07a1f\" stroke-width=\"2\" data-kid=\"21\"><rect x=\"3\" y=\"3\" width=\"7\" height=\"7\" data-kid=\"22\"></rect><rect x=\"14\" y=\"3\" width=\"7\" height=\"7\" data-kid=\"23\"></rect><rect x=\"3\" y=\"14\" width=\"7\" height=\"7\" data-kid=\"24\"></rect><rect x=\"14\" y=\"14\" width=\"7\" height=\"7\" data-kid=\"25\"></rect></svg>\n      Catalogue\n    </p>\n    <h1 style=\"font-family:'Plus Jakarta Sans',sans-serif; font-size:52px; font-weight:800; letter-spacing:-0.02em; color:white; margin-bottom:16px; line-height:1.1;\" data-kid=\"26\">Tous nos services</h1>\n    <p style=\"font-size:18px; color:rgba(255,255,255,0.8); max-width:500px; margin:0 auto 36px; line-height:1.65;\" data-kid=\"27\">Métiers vérifiés et prestataires classés par profession pour votre projet.</p>\n    \n    <div style=\"position:relative; max-width:520px; margin:0 auto;\" data-kid=\"28\">\n      <svg style=\"position:absolute; left:18px; top:50%; transform:translateY(-50%); pointer-events:none;\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#9ca3af\" stroke-width=\"2\" data-kid=\"29\"><circle cx=\"11\" cy=\"11\" r=\"8\" data-kid=\"30\"></circle><path d=\"m21 21-4.35-4.35\" data-kid=\"31\"></path></svg>\n      <input type=\"text\" placeholder=\"Filtrer un métier...\" style=\"width:100%; height:52px; padding-left:48px; padding-right:20px; border-radius:14px; background:white; border:1px solid rgba(0,0,0,0.1); font-size:15px; font-family:'DM Sans',sans-serif; color:#1a2133; outline:none; box-shadow:0 4px 16px rgba(0,0,0,0.12);\" data-kid=\"32\">\n    </div>\n  </div>\n</section>\n\n\n<section style=\"padding:56px 40px 72px;\" data-kid=\"33\">\n  <div style=\"max-width:1280px; margin:0 auto;\" data-kid=\"34\">\n    \n    <div style=\"display:flex; align-items:center; justify-content:space-between; margin-bottom:32px;\" data-kid=\"35\">\n      <p style=\"font-size:14px; color:#6b7280;\" data-kid=\"36\"><strong style=\"color:#1a2133;\" data-kid=\"37\">9 services</strong> disponibles</p>\n      <div style=\"display:flex; align-items:center; gap:8px;\" data-kid=\"38\">\n        <span style=\"font-size:13px; color:#6b7280;\" data-kid=\"39\">Trier par :</span>\n        <select style=\"font-size:13px; font-family:'DM Sans',sans-serif; color:#1a2133; border:1px solid #e5e1d8; border-radius:8px; padding:7px 12px; background:white; cursor:pointer; outline:none;\" data-kid=\"40\">\n          <option data-kid=\"41\">Popularité</option>\n          <option data-kid=\"42\">Alphabétique</option>\n        </select>\n      </div>\n    </div>\n    <div style=\"display:grid; grid-template-columns:repeat(3,1fr); gap:24px;\" data-kid=\"43\">\n      \n      <div style=\"border-radius:18px; border:1px solid #e5e1d8; background:white; padding:28px; box-shadow:0 2px 12px rgba(0,0,0,0.05); cursor:pointer; transition:all 0.2s;\" data-kid=\"44\">\n        <div style=\"width:60px; height:60px; border-radius:16px; background:linear-gradient(135deg,#facc15,#f97316); display:flex; align-items:center; justify-content:center; margin-bottom:20px; box-shadow:0 8px 20px rgba(249,115,22,0.3);\" data-kid=\"45\">\n          <svg width=\"28\" height=\"28\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"white\" stroke-width=\"2\" stroke-linecap=\"round\" data-kid=\"46\"><polygon points=\"13,2 3,14 12,14 11,22 21,10 12,10\" data-kid=\"47\"></polygon></svg>\n        </div>\n        <h2 style=\"font-family:'Plus Jakarta Sans',sans-serif; font-size:19px; font-weight:700; color:#1a2133; margin-bottom:8px;\" data-kid=\"48\">Électricité</h2>\n        <p style=\"font-size:13px; color:#9ca3af; margin-bottom:20px; line-height:1.6;\" data-kid=\"49\">Installation, réparation et mise aux normes des installations électriques résidentielles et commerciales.</p>\n        <div style=\"display:flex; align-items:center; justify-content:space-between; border-top:1px solid #f3f0ea; padding-top:16px;\" data-kid=\"50\">\n          <span style=\"font-size:14px; color:#6b7280;\" data-kid=\"51\"><strong style=\"color:#1a2133; font-size:16px; font-family:'Plus Jakarta Sans',sans-serif;\" data-kid=\"52\">24</strong> prestataires</span>\n          <span style=\"display:flex; align-items:center; gap:5px; color:#e07a1f; font-size:13px; font-weight:700;\" data-kid=\"53\">Voir les pros <svg width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" data-kid=\"54\"><path d=\"M5 12h14M12 5l7 7-7 7\" data-kid=\"55\"></path></svg></span>\n        </div>\n      </div>\n      \n      <div style=\"border-radius:18px; border:1px solid #e5e1d8; background:white; padding:28px; box-shadow:0 2px 12px rgba(0,0,0,0.05); cursor:pointer;\" data-kid=\"56\">\n        <div style=\"width:60px; height:60px; border-radius:16px; background:linear-gradient(135deg,#60a5fa,#06b6d4); display:flex; align-items:center; justify-content:center; margin-bottom:20px; box-shadow:0 8px 20px rgba(6,182,212,0.3);\" data-kid=\"57\">\n          <svg width=\"28\" height=\"28\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"white\" stroke-width=\"2\" stroke-linecap=\"round\" data-kid=\"58\"><path d=\"M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z\" data-kid=\"59\"></path></svg>\n        </div>\n        <h2 style=\"font-family:'Plus Jakarta Sans',sans-serif; font-size:19px; font-weight:700; color:#1a2133; margin-bottom:8px;\" data-kid=\"60\">Plomberie</h2>\n        <p style=\"font-size:13px; color:#9ca3af; margin-bottom:20px; line-height:1.6;\" data-kid=\"61\">Robinetterie, tuyauterie, installation sanitaire et réparation de fuites d'eau.</p>\n        <div style=\"display:flex; align-items:center; justify-content:space-between; border-top:1px solid #f3f0ea; padding-top:16px;\" data-kid=\"62\">\n          <span style=\"font-size:14px; color:#6b7280;\" data-kid=\"63\"><strong style=\"color:#1a2133; font-size:16px; font-family:'Plus Jakarta Sans',sans-serif;\" data-kid=\"64\">18</strong> prestataires</span>\n          <span style=\"display:flex; align-items:center; gap:5px; color:#e07a1f; font-size:13px; font-weight:700;\" data-kid=\"65\">Voir les pros <svg width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" data-kid=\"66\"><path d=\"M5 12h14M12 5l7 7-7 7\" data-kid=\"67\"></path></svg></span>\n        </div>\n      </div>\n      \n      <div style=\"border-radius:18px; border:1px solid #e5e1d8; background:white; padding:28px; box-shadow:0 2px 12px rgba(0,0,0,0.05); cursor:pointer;\" data-kid=\"68\">\n        <div style=\"width:60px; height:60px; border-radius:16px; background:linear-gradient(135deg,#f59e0b,#ea580c); display:flex; align-items:center; justify-content:center; margin-bottom:20px; box-shadow:0 8px 20px rgba(245,158,11,0.3);\" data-kid=\"69\">\n          <svg width=\"28\" height=\"28\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"white\" stroke-width=\"2\" stroke-linecap=\"round\" data-kid=\"70\"><path d=\"M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z\" data-kid=\"71\"></path></svg>\n        </div>\n        <h2 style=\"font-family:'Plus Jakarta Sans',sans-serif; font-size:19px; font-weight:700; color:#1a2133; margin-bottom:8px;\" data-kid=\"72\">Menuiserie</h2>\n        <p style=\"font-size:13px; color:#9ca3af; margin-bottom:20px; line-height:1.6;\" data-kid=\"73\">Fabrication et pose de meubles sur mesure, portes, fenêtres et boiseries intérieures.</p>\n        <div style=\"display:flex; align-items:center; justify-content:space-between; border-top:1px solid #f3f0ea; padding-top:16px;\" data-kid=\"74\">\n          <span style=\"font-size:14px; color:#6b7280;\" data-kid=\"75\"><strong style=\"color:#1a2133; font-size:16px; font-family:'Plus Jakarta Sans',sans-serif;\" data-kid=\"76\">15</strong> prestataires</span>\n          <span style=\"display:flex; align-items:center; gap:5px; color:#e07a1f; font-size:13px; font-weight:700;\" data-kid=\"77\">Voir les pros <svg width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" data-kid=\"78\"><path d=\"M5 12h14M12 5l7 7-7 7\" data-kid=\"79\"></path></svg></span>\n        </div>\n      </div>\n      \n      <div style=\"border-radius:18px; border:1px solid rgba(168,85,247,0.25); background:white; padding:28px; box-shadow:0 2px 12px rgba(0,0,0,0.05); cursor:pointer; outline:2px solid #e07a1f; outline-offset:-1px; position:relative;\" data-kid=\"80\">\n        <div style=\"position:absolute; top:16px; right:16px; background:#e07a1f; color:white; font-size:10px; font-weight:700; padding:3px 8px; border-radius:100px; text-transform:uppercase; letter-spacing:0.06em;\" data-kid=\"81\">Populaire</div>\n        <div style=\"width:60px; height:60px; border-radius:16px; background:linear-gradient(135deg,#a855f7,#ec4899); display:flex; align-items:center; justify-content:center; margin-bottom:20px; box-shadow:0 8px 20px rgba(168,85,247,0.3);\" data-kid=\"82\">\n          <svg width=\"28\" height=\"28\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"white\" stroke-width=\"2\" data-kid=\"83\"><rect x=\"3\" y=\"3\" width=\"18\" height=\"18\" rx=\"2\" data-kid=\"84\"></rect><circle cx=\"8.5\" cy=\"8.5\" r=\"1.5\" data-kid=\"85\"></circle><polyline points=\"21,15 16,10 5,21\" data-kid=\"86\"></polyline></svg>\n        </div>\n        <h2 style=\"font-family:'Plus Jakarta Sans',sans-serif; font-size:19px; font-weight:700; color:#1a2133; margin-bottom:8px;\" data-kid=\"87\">Peinture</h2>\n        <p style=\"font-size:13px; color:#9ca3af; margin-bottom:20px; line-height:1.6;\" data-kid=\"88\">Peinture intérieure et extérieure, ravalement de façade et décoration murale artistique.</p>\n        <div style=\"display:flex; align-items:center; justify-content:space-between; border-top:1px solid #f3f0ea; padding-top:16px;\" data-kid=\"89\">\n          <span style=\"font-size:14px; color:#6b7280;\" data-kid=\"90\"><strong style=\"color:#1a2133; font-size:16px; font-family:'Plus Jakarta Sans',sans-serif;\" data-kid=\"91\">21</strong> prestataires</span>\n          <span style=\"display:flex; align-items:center; gap:5px; color:#e07a1f; font-size:13px; font-weight:700;\" data-kid=\"92\">Voir les pros <svg width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" data-kid=\"93\"><path d=\"M5 12h14M12 5l7 7-7 7\" data-kid=\"94\"></path></svg></span>\n        </div>\n      </div>\n      \n      <div style=\"border-radius:18px; border:1px solid #e5e1d8; background:white; padding:28px; box-shadow:0 2px 12px rgba(0,0,0,0.05); cursor:pointer;\" data-kid=\"95\">\n        <div style=\"width:60px; height:60px; border-radius:16px; background:linear-gradient(135deg,#2dd4bf,#3b82f6); display:flex; align-items:center; justify-content:center; margin-bottom:20px; box-shadow:0 8px 20px rgba(59,130,246,0.3);\" data-kid=\"96\">\n          <svg width=\"28\" height=\"28\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"white\" stroke-width=\"2\" stroke-linecap=\"round\" data-kid=\"97\"><path d=\"M9.59 4.59A2 2 0 1 1 11 8H2m10.59 11.41A2 2 0 1 0 10 16H2m15.73-8.27A2.5 2.5 0 1 1 19.5 12H2\" data-kid=\"98\"></path></svg>\n        </div>\n        <h2 style=\"font-family:'Plus Jakarta Sans',sans-serif; font-size:19px; font-weight:700; color:#1a2133; margin-bottom:8px;\" data-kid=\"99\">Climatisation</h2>\n        <p style=\"font-size:13px; color:#9ca3af; margin-bottom:20px; line-height:1.6;\" data-kid=\"100\">Installation, entretien et dépannage de systèmes de climatisation et ventilation.</p>\n        <div style=\"display:flex; align-items:center; justify-content:space-between; border-top:1px solid #f3f0ea; padding-top:16px;\" data-kid=\"101\">\n          <span style=\"font-size:14px; color:#6b7280;\" data-kid=\"102\"><strong style=\"color:#1a2133; font-size:16px; font-family:'Plus Jakarta Sans',sans-serif;\" data-kid=\"103\">12</strong> prestataires</span>\n          <span style=\"display:flex; align-items:center; gap:5px; color:#e07a1f; font-size:13px; font-weight:700;\" data-kid=\"104\">Voir les pros <svg width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" data-kid=\"105\"><path d=\"M5 12h14M12 5l7 7-7 7\" data-kid=\"106\"></path></svg></span>\n        </div>\n      </div>\n      \n      <div style=\"border-radius:18px; border:1px solid #e5e1d8; background:white; padding:28px; box-shadow:0 2px 12px rgba(0,0,0,0.05); cursor:pointer;\" data-kid=\"107\">\n        <div style=\"width:60px; height:60px; border-radius:16px; background:linear-gradient(135deg,#fb923c,#ef4444); display:flex; align-items:center; justify-content:center; margin-bottom:20px; box-shadow:0 8px 20px rgba(239,68,68,0.3);\" data-kid=\"108\">\n          <svg width=\"28\" height=\"28\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"white\" stroke-width=\"2\" stroke-linecap=\"round\" data-kid=\"109\"><path d=\"M2 20h20M6 20V10m4 10V4m4 16v-6m4 6v-2\" data-kid=\"110\"></path></svg>\n        </div>\n        <h2 style=\"font-family:'Plus Jakarta Sans',sans-serif; font-size:19px; font-weight:700; color:#1a2133; margin-bottom:8px;\" data-kid=\"111\">Maçonnerie</h2>\n        <p style=\"font-size:13px; color:#9ca3af; margin-bottom:20px; line-height:1.6;\" data-kid=\"112\">Construction, rénovation, crépissage et travaux de gros-œuvre résidentiels et commerciaux.</p>\n        <div style=\"display:flex; align-items:center; justify-content:space-between; border-top:1px solid #f3f0ea; padding-top:16px;\" data-kid=\"113\">\n          <span style=\"font-size:14px; color:#6b7280;\" data-kid=\"114\"><strong style=\"color:#1a2133; font-size:16px; font-family:'Plus Jakarta Sans',sans-serif;\" data-kid=\"115\">19</strong> prestataires</span>\n          <span style=\"display:flex; align-items:center; gap:5px; color:#e07a1f; font-size:13px; font-weight:700;\" data-kid=\"116\">Voir les pros <svg width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" data-kid=\"117\"><path d=\"M5 12h14M12 5l7 7-7 7\" data-kid=\"118\"></path></svg></span>\n        </div>\n      </div>\n      \n      <div style=\"border-radius:18px; border:1px solid #e5e1d8; background:white; padding:28px; box-shadow:0 2px 12px rgba(0,0,0,0.05); cursor:pointer;\" data-kid=\"119\">\n        <div style=\"width:60px; height:60px; border-radius:16px; background:linear-gradient(135deg,#6b7280,#374151); display:flex; align-items:center; justify-content:center; margin-bottom:20px; box-shadow:0 8px 20px rgba(107,114,128,0.3);\" data-kid=\"120\">\n          <svg width=\"28\" height=\"28\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"white\" stroke-width=\"2\" stroke-linecap=\"round\" data-kid=\"121\"><path d=\"M14 16H9m10 0h3v-3.15a1 1 0 0 0-.84-.99l-6.25-1.02a1 1 0 0 1-.74-.61l-2.21-6.18A2 2 0 0 0 10.08 3H9.5a2 2 0 0 0-1.93 1.46l-1.9 7.16A2 2 0 0 0 7.6 14H9\" data-kid=\"122\"></path><circle cx=\"10.5\" cy=\"18.5\" r=\"2.5\" data-kid=\"123\"></circle><circle cx=\"17.5\" cy=\"18.5\" r=\"2.5\" data-kid=\"124\"></circle></svg>\n        </div>\n        <h2 style=\"font-family:'Plus Jakarta Sans',sans-serif; font-size:19px; font-weight:700; color:#1a2133; margin-bottom:8px;\" data-kid=\"125\">Mécanique</h2>\n        <p style=\"font-size:13px; color:#9ca3af; margin-bottom:20px; line-height:1.6;\" data-kid=\"126\">Réparation auto, entretien moteur, diagnostic et révision de véhicules toutes marques.</p>\n        <div style=\"display:flex; align-items:center; justify-content:space-between; border-top:1px solid #f3f0ea; padding-top:16px;\" data-kid=\"127\">\n          <span style=\"font-size:14px; color:#6b7280;\" data-kid=\"128\"><strong style=\"color:#1a2133; font-size:16px; font-family:'Plus Jakarta Sans',sans-serif;\" data-kid=\"129\">11</strong> prestataires</span>\n          <span style=\"display:flex; align-items:center; gap:5px; color:#e07a1f; font-size:13px; font-weight:700;\" data-kid=\"130\">Voir les pros <svg width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" data-kid=\"131\"><path d=\"M5 12h14M12 5l7 7-7 7\" data-kid=\"132\"></path></svg></span>\n        </div>\n      </div>\n      \n      <div style=\"border-radius:18px; border:1px solid #e5e1d8; background:white; padding:28px; box-shadow:0 2px 12px rgba(0,0,0,0.05); cursor:pointer;\" data-kid=\"133\">\n        <div style=\"width:60px; height:60px; border-radius:16px; background:linear-gradient(135deg,#818cf8,#7c3aed); display:flex; align-items:center; justify-content:center; margin-bottom:20px; box-shadow:0 8px 20px rgba(124,58,237,0.3);\" data-kid=\"134\">\n          <svg width=\"28\" height=\"28\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"white\" stroke-width=\"2\" stroke-linecap=\"round\" data-kid=\"135\"><rect x=\"2\" y=\"3\" width=\"20\" height=\"14\" rx=\"2\" data-kid=\"136\"></rect><line x1=\"8\" y1=\"21\" x2=\"16\" y2=\"21\" data-kid=\"137\"></line><line x1=\"12\" y1=\"17\" x2=\"12\" y2=\"21\" data-kid=\"138\"></line></svg>\n        </div>\n        <h2 style=\"font-family:'Plus Jakarta Sans',sans-serif; font-size:19px; font-weight:700; color:#1a2133; margin-bottom:8px;\" data-kid=\"139\">Informatique</h2>\n        <p style=\"font-size:13px; color:#9ca3af; margin-bottom:20px; line-height:1.6;\" data-kid=\"140\">Dépannage PC, installation de logiciels, réseaux et maintenance informatique à domicile.</p>\n        <div style=\"display:flex; align-items:center; justify-content:space-between; border-top:1px solid #f3f0ea; padding-top:16px;\" data-kid=\"141\">\n          <span style=\"font-size:14px; color:#6b7280;\" data-kid=\"142\"><strong style=\"color:#1a2133; font-size:16px; font-family:'Plus Jakarta Sans',sans-serif;\" data-kid=\"143\">9</strong> prestataires</span>\n          <span style=\"display:flex; align-items:center; gap:5px; color:#e07a1f; font-size:13px; font-weight:700;\" data-kid=\"144\">Voir les pros <svg width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" data-kid=\"145\"><path d=\"M5 12h14M12 5l7 7-7 7\" data-kid=\"146\"></path></svg></span>\n        </div>\n      </div>\n      \n      <div style=\"border-radius:18px; border:1px solid #e5e1d8; background:white; padding:28px; box-shadow:0 2px 12px rgba(0,0,0,0.05); cursor:pointer;\" data-kid=\"147\">\n        <div style=\"width:60px; height:60px; border-radius:16px; background:linear-gradient(135deg,#fb7185