troke-width=\"2.5\" data-kid=\"200\"><path d=\"M5 12h14M12 5l7 7-7 7\" data-kid=\"201\"></path></svg>\n      </button>\n    </div>\n    \n    <div style=\"background:white; border-radius:16px; border:1px solid #e5e1d8; padding:22px; box-shadow:0 2px 8px rgba(0,0,0,0.04);\" data-kid=\"202\">\n      <h3 style=\"font-family:'Plus Jakarta Sans',sans-serif; font-size:14px; font-weight:700; color:#1a2133; margin-bottom:16px;\" data-kid=\"203\">Comment ça marche</h3>\n      <div style=\"display:flex; flex-direction:column; gap:14px;\" data-kid=\"204\">\n        <div style=\"display:flex; align-items:flex-start; gap:12px;\" data-kid=\"205\">\n          <div style=\"width:28px; height:28px; border-radius:8px; background:#f0f7f3; display:flex; align-items:center; justify-content:center; flex-shrink:0; font-family:'Plus Jakarta Sans',sans-serif; font-size:12px; font-weight:800; color:#1a5c35;\" data-kid=\"206\">1</div>\n          <div data-kid=\"207\">\n            <p style=\"font-size:13px; font-weight:600; color:#1a2133; margin-bottom:2px;\" data-kid=\"208\">Publiez votre demande</p>\n            <p style=\"font-size:12px; color:#9ca3af; line-height:1.5;\" data-kid=\"209\">Gratuit, en 2 minutes</p>\n          </div>\n        </div>\n        <div style=\"display:flex; align-items:flex-start; gap:12px;\" data-kid=\"210\">\n          <div style=\"width:28px; height:28px; border-radius:8px; background:#fef3e7; display:flex; align-items:center; justify-content:center; flex-shrink:0; font-family:'Plus Jakarta Sans',sans-serif; font-size:12px; font-weight:800; color:#e07a1f;\" data-kid=\"211\">2</div>\n          <div data-kid=\"212\">\n            <p style=\"font-size:13px; font-weight:600; color:#1a2133; margin-bottom:2px;\" data-kid=\"213\">Recevez des devis</p>\n            <p style=\"font-size:12px; color:#9ca3af; line-height:1.5;\" data-kid=\"214\">Sous 24h des meilleurs pros</p>\n          </div>\n        </div>\n        <div style=\"display:flex; align-items:flex-start; gap:12px;\" data-kid=\"215\">\n          <div style=\"width:28px; height:28px; border-radius:8px; background:#f0f7f3; display:flex; align-items:center; justify-content:center; flex-shrink:0; font-family:'Plus Jakarta Sans',sans-serif; font-size:12px; font-weight:800; color:#1a5c35;\" data-kid=\"216\">3</div>\n          <div data-kid=\"217\">\n            <p style=\"font-size:13px; font-weight:600; color:#1a2133; margin-bottom:2px;\" data-kid=\"218\">Choisissez et signez</p>\n            <p style=\"font-size:12px; color:#9ca3af; line-height:1.5;\" data-kid=\"219\">Contrat numérique sécurisé</p>\n          </div>\n        </div>\n        <div style=\"display:flex; align-items:flex-start; gap:12px;\" data-kid=\"220\">\n          <div style=\"width:28px; height:28px; border-radius:8px; background:#fef3e7; display:flex; align-items:center; justify-content:center; flex-shrink:0; font-family:'Plus Jakarta Sans',sans-serif; font-size:12px; font-weight:800; color:#e07a1f;\" data-kid=\"221\">4</div>\n          <div data-kid=\"222\">\n            <p style=\"font-size:13px; font-weight:600; color:#1a2133; margin-bottom:2px;\" data-kid=\"223\">Payez en Mobile Money</p>\n            <p style=\"font-size:12px; color:#9ca3af; line-height:1.5;\" data-kid=\"224\">Après validation de la mission</p>\n          </div>\n        </div>\n      </div>\n    </div>\n    \n    <div style=\"background:white; border-radius:16px; border:1px solid #e5e1d8; padding:20px; box-shadow:0 2px 8px rgba(0,0,0,0.04);\" data-kid=\"225\">\n      <div style=\"display:flex; flex-direction:column; gap:12px;\" data-kid=\"226\">\n        <div style=\"display:flex; align-items:center; gap:10px;\" data-kid=\"227\">\n          <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#1a5c35\" stroke-width=\"2\" data-kid=\"228\"><path d=\"M22 11.08V12a10 10 0 1 1-5.93-9.14\" data-kid=\"229\"></path><polyline points=\"22,4 12,14.01 9,11.01\" data-kid=\"230\"></polyline></svg>\n          <span style=\"font-size:13px; color:#4a5568;\" data-kid=\"231\">Tous les prestataires sont vérifiés</span>\n        </div>\n        <div style=\"display:flex; align-items:center; gap:10px;\" data-kid=\"232\">\n          <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#1a5c35\" stroke-width=\"2\" data-kid=\"233\"><path d=\"M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z\" data-kid=\"234\"></path></svg>\n          <span style=\"font-size:13px; color:#4a5568;\" data-kid=\"235\">Contrats numériques inclus</span>\n        </div>\n        <div style=\"display:flex; align-items:center; gap:10px;\" data-kid=\"236\">\n          <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#1a5c35\" stroke-width=\"2\" data-kid=\"237\"><rect x=\"1\" y=\"4\" width=\"22\" height=\"16\" rx=\"2\" ry=\"2\" data-kid=\"238\"></rect><line x1=\"1\" y1=\"10\" x2=\"23\" y2=\"10\" data-kid=\"239\"></line></svg>\n          <span style=\"font-size:13px; color:#4a5568;\" data-kid=\"240\">Paiement sécurisé Mobile Money</span>\n        </div>\n      </div>\n    </div>\n  </div>\n</div>\n",
