radius:10px; cursor:pointer;\" data-kid=\"43\">\n        <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"rgba(255,255,255,0.5)\" stroke-width=\"2\" data-kid=\"44\"><path d=\"M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z\" data-kid=\"45\"></path></svg>\n        <span style=\"font-size:14px; font-weight:500; color:rgba(255,255,255,0.6);\" data-kid=\"46\">Messages</span>\n        <span style=\"margin-left:auto; background:#ef4444; color:white; font-size:10px; font-weight:700; padding:2px 7px; border-radius:100px;\" data-kid=\"47\">1</span>\n      </div>\n      <div style=\"display:flex; align-items:center; gap:12px; padding:11px 14px; border-radius:10px; cursor:pointer;\" data-kid=\"48\">\n        <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"rgba(255,255,255,0.5)\" stroke-width=\"2\" data-kid=\"49\"><path d=\"M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2\" data-kid=\"50\"></path><circle cx=\"12\" cy=\"7\" r=\"4\" data-kid=\"51\"></circle></svg>\n        <span style=\"font-size:14px; font-weight:500; color:rgba(255,255,255,0.6);\" data-kid=\"52\">Mon profil</span>\n      </div>\n    </nav>\n    <div style=\"padding:16px; border-top:1px solid rgba(255,255,255,0.08);\" data-kid=\"53\">\n      <button style=\"width:100%; display:flex; align-items:center; justify-content:center; gap:8px; padding:12px 16px; border-radius:10px; background:#e07a1f; border:none; color:white; font-size:14px; font-weight:700; font-family:'DM Sans',sans-serif; cursor:pointer;\" data-kid=\"54\">\n        <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" data-kid=\"55\"><line x1=\"12\" y1=\"5\" x2=\"12\" y2=\"19\" data-kid=\"56\"></line><line x1=\"5\" y1=\"12\" x2=\"19\" y2=\"12\" data-kid=\"57\"></line></svg>\n        Nouvelle demande\n      </button>\n    </div>\n  </aside>\n\n  \n  <div style=\"flex:1; display:flex; flex-direction:column; min-width:0;\" data-kid=\"