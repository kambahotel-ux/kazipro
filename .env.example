# API Laravel
VITE_API_URL=http://127.0.0.1:8002/api

# Optional: API Keys for Payment Providers
# VITE_MPESA_API_KEY=your-mpesa-key
# VITE_AIRTEL_API_KEY=your-airtel-key
# VITE_ORANGE_API_KEY=your-orange-key

# Optional: Other Configuration
# VITE_APP_NAME=KaziPro
# VITE_APP_URL=http://localhost:8080

# Paiement mobile money — simulation locale (dev)
# VITE_PAYMENTS_SIMULATION=true

# En dev sans VITE_API_URL : proxy Vite /api → http://127.0.0.1:8002
